    /* 2. 禁用 DMA 半传输中断 (Half Transfer Interrupt) */
    /* 【非常关键】：如果不禁用此中断，当接收数据量达到 RX_BUFFER_SIZE 的一半时，
     * 底层也会触发一次回调，这会导致原本完整的一长帧指令被错误地劈成两半。 */
    __HAL_DMA_DISABLE_IT(&hdma_usart1_rx, DMA_IT_HT);
