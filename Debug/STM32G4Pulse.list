 8003c22:	af00      	add	r7, sp, #0
    /* 1. 开启串口 DMA 空闲中断接收模式 */
    /* 将接收到的数据自动搬运到 rx_buffer 中，最大监听长度为 RX_BUFFER_SIZE */
    HAL_UARTEx_ReceiveToIdle_DMA(&huart1, rx_buffer, RX_BUFFER_SIZE);
